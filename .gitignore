# >>> hero gitignore (managed) >>>
# Per-project local overrides (tokens, personal preferences)
.hero/hero.local.json

# Knowledge graph cache (regenerable from sources of truth)
.hero/graph.db
.hero/graph.db-wal
.hero/graph.db-shm

# Search index cache (regenerable via `hero index`)
.hero/index.db
.hero/index.db-wal
.hero/index.db-shm

# Per-machine NEXT state (rewritten every Stop hook + agent scratch)
.hero/next/*.local.md

# Auto-generated code intelligence (re-scan to regenerate)
.hero/knowledge/code/

# Per-machine satellite manifest (which subprojects are symlinked locally)
.hero/satellites.local.json
# <<< hero gitignore (managed) <<<

# Per-machine Hero runtime state (session locks, PID files, caches).
# .hero/events.log is deliberately NOT here: it is append-only project
# history that hero's pre-commit hook stages, and .gitattributes gives it
# merge=union for exactly that reason.
.hero/.active-sessions.json
.hero/cache/
.hero/sessions/
.hero/*.pid
